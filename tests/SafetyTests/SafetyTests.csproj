<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the parts of Kilim that touch user files against real files, without the UI.
       No test framework, so no extra packages: exit code 0 means every check passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Kilim\Storage.cs" />
    <Compile Include="..\..\src\Kilim\Shell.cs" />
    <Compile Include="..\..\src\Kilim\Native.cs" />
  </ItemGroup>

</Project>
